---
/*
 * Architecture flow for one case study: the 3D scene slot (filled on desktop by
 * src/scenes), a 2D SVG of the same flow as the fallback, a live caption that walks
 * through the steps, and a clickable legend. All content comes from src/data/flows.ts.
 */
import { flows, orderedNodes } from '../data/flows';
import type { Project } from '../data/resume';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const flow = flows[project.slug];
if (!flow) throw new Error(`No flow defined for project "${project.slug}"`);

const ordered = orderedNodes(flow);
const first = ordered[0]!;
const primary = flow.routes[0] ?? [];

// 2D projection for the fallback: stage x in [-5.2, 5.2] → 24..376, y in [-3.4, 2.4] → 20..200.
const W = 400;
const H = 230;
const px = (x: number) => 24 + ((x + 5.2) / 10.4) * (W - 48);
const py = (y: number) => 118 - y * 34;
const orbiters = flow.nodes.filter((n) => n.orbits);
const placed = flow.nodes.map((n, i) => {
  if (n.orbits) {
    const centre = flow.nodes.find((c) => c.id === n.orbits)!;
    const k = orbiters.indexOf(n);
    const a = (k / orbiters.length) * Math.PI * 2;
    return { ...n, x: px(centre.pos[0]) + Math.cos(a) * 54, y: py(centre.pos[1]) + Math.sin(a) * 34, orbit: true, i };
  }
  return { ...n, x: px(n.pos[0]), y: py(n.pos[1]), orbit: false, i };
});
const at = (id: string) => placed.find((p) => p.id === id)!;
const strokeFor = (kind: string) =>
  kind === 'service' ? 'var(--accent-link)' : kind === 'external' || kind === 'store' ? 'var(--text-muted)' : 'var(--accent-glow)';
---

<div class="flow" data-flow-card>
  <figure
    class="flow-stage scene-slot relative aspect-[16/10] overflow-hidden rounded-xl bg-dock"
    data-flow={project.slug}
    role="img"
    aria-label={flow.summary}
  >
    <svg class="flow-fallback h-full w-full" viewBox={`0 0 ${W} ${H}`} fill="none" aria-hidden="true">
      {flow.edges.map((e) => {
        const a = at(e.from);
        const b = at(e.to);
        return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} stroke="var(--text-muted)" stroke-opacity={e.dashed ? 0.45 : 0.3} stroke-dasharray={e.dashed ? '4 4' : undefined} stroke-width="1.25" />;
      })}
      {placed.filter((p) => p.orbit).map((p) => {
        const c = at(p.orbits!);
        return <line x1={c.x} y1={c.y} x2={p.x} y2={p.y} stroke="var(--text-muted)" stroke-opacity="0.2" stroke-width="1" />;
      })}
      {placed.map((p) => (
        <g>
          <circle cx={p.x} cy={p.y} r={p.orbit ? 7 : 10} fill="var(--surface-card)" stroke={strokeFor(p.kind)} stroke-width="1.5" />
          <text
            x={p.x}
            y={p.y + (p.orbit ? 16 : p.pos[1] < -1.5 ? 22 : -16)}
            text-anchor="middle"
            fill="var(--text-muted)"
            font-size={p.orbit ? 7.5 : 8.5}
            font-family="JetBrains Mono Variable, monospace"
          >
            {p.label}
          </text>
        </g>
      ))}
    </svg>
    <span class="flow-hint" aria-hidden="true">drag to rotate · hover a node</span>
  </figure>

  <div class="flow-info mt-3 rounded-xl border border-line bg-dock/60 p-4" aria-live="polite">
    <p class="font-mono text-[11px] uppercase tracking-wider text-accent-glow" data-flow-step>step 1 of {primary.length}</p>
    <p class="display mt-1 text-base font-semibold text-ink" data-flow-title>{first.label}</p>
    <p class="mt-1 text-sm leading-relaxed text-ink-muted" data-flow-blurb>{first.blurb}</p>
  </div>

  <ol class="flow-legend mt-3 flex flex-wrap gap-1.5" data-flow-legend aria-label="Steps in this flow">
    {ordered.map((n, i) => (
      <li>
        <button type="button" class="chip flow-chip" data-node={n.id} title={n.blurb}>
          <span class="text-accent-glow">{String(i + 1).padStart(2, '0')}</span>&nbsp;{n.label}
        </button>
      </li>
    ))}
  </ol>

  <details class="mt-3 text-sm">
    <summary class="cursor-pointer font-mono text-xs text-link hover:underline">Every step, in words</summary>
    <ol class="mt-2 list-decimal space-y-1 pl-5 text-ink-muted">
      {ordered.map((n) => (
        <li><span class="text-ink">{n.label}.</span> {n.blurb}</li>
      ))}
    </ol>
  </details>
</div>
