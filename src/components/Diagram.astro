---
/*
 * 2D architecture diagram placeholder. Phase 4 replaces each with a 3D scene and
 * keeps this SVG as the mobile and reduced-motion fallback.
 */
import type { Project } from '../data/resume';
interface Props {
  project: Project;
}
const { project } = Astro.props;
const steps = project.diagram.split('→').map((s) => s.trim()).slice(0, 4);
---

<figure
  class="scene-slot relative flex min-h-72 items-center justify-center overflow-hidden rounded-xl bg-dock p-6"
  data-scene={project.slug}
  role="img"
  aria-label={project.diagram}
>
  <svg viewBox="0 0 400 200" class="w-full max-w-md" fill="none" stroke-width="1.5" aria-hidden="true">
    <defs>
      <linearGradient id={`g-${project.slug}`} x1="0" x2="1">
        <stop offset="0" stop-color="var(--accent-glow)" />
        <stop offset="1" stop-color="var(--accent-link)" />
      </linearGradient>
    </defs>
    <path d="M60 100 H340" stroke={`url(#g-${project.slug})`} stroke-dasharray="6 6" />
    {steps.map((step, i) => {
      const x = 60 + (i * 280) / Math.max(steps.length - 1, 1);
      // Keep labels short; the SVG is a placeholder until the 3D scenes land.
      const label = step.replace(/\s*\(.*$/, '').split(' or ')[0].slice(0, 18);
      return (
        <g>
          <circle cx={x} cy="100" r="18" fill="var(--surface-card)" stroke={i === 0 ? 'var(--accent-glow)' : i === steps.length - 1 ? 'var(--text-muted)' : 'var(--accent-link)'} />
          <text x={x} y={i % 2 ? 150 : 65} text-anchor="middle" fill="var(--text-muted)" font-size="10" font-family="JetBrains Mono Variable">{label}</text>
        </g>
      );
    })}
  </svg>
  <figcaption class="absolute right-3 top-3 font-mono text-[10px] text-ink-muted">3D scene · phase 4</figcaption>
</figure>
