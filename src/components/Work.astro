---
import { projects, moreWork } from '../data/resume';
import SectionHeader from './SectionHeader.astro';
import FlowFigure from './FlowFigure.astro';
---

<section id="work" class="scroll-mt-24 py-24">
  <SectionHeader index="02" label="featured work" title="Systems I designed and built" />
  <p class="-mt-6 mb-10 max-w-2xl text-ink-muted">
    Each case study has an interactive architecture diagram. Hover a node for what it does, click to pin it,
    drag to rotate, and use the numbered steps to jump through the flow.
  </p>

  <div class="grid gap-8">
    {projects.map((p, i) => (
      <article
        id={`project-${p.slug}`}
        class={`glass grid gap-10 p-8 md:grid-cols-2 md:p-12 ${i === 0 ? 'edge-glow' : ''}`}
        data-project={p.slug}
      >
        <div class={i % 2 ? 'md:order-2' : ''}>
          <p class="mb-2 font-mono text-xs text-ink-muted">{String(i + 1).padStart(2, '0')} · {p.org}</p>
          <h3 class="display text-2xl font-semibold md:text-3xl">{p.name}</h3>
          <p class="mt-3 flex items-center gap-2 font-mono text-xs text-accent-glow">
            <span class="status-dot"></span> {p.status}
          </p>
          <p class="mt-5 text-lg text-ink">{p.headline}</p>
          <p class="mt-3 text-ink-muted">{p.body}</p>
          <details class="group mt-4">
            <summary class="cursor-pointer list-none font-mono text-sm text-link hover:underline">
              <span class="group-open:hidden">More detail →</span>
              <span class="hidden group-open:inline">Less ↑</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">{p.detail}</p>
          </details>
          <div class="mt-6 flex flex-wrap gap-2">
            {p.tech.map((t) => <span class="chip">{t}</span>)}
          </div>
          {p.link && (
            <a href={p.link.href} class="link mt-6 inline-block text-sm" target="_blank" rel="noopener">
              {p.link.label} ↗
            </a>
          )}
          {p.personal && (
            <p class="mt-4 font-mono text-xs text-ink-muted">Personal side project, in development. Repository is private.</p>
          )}
        </div>
        <div class={i % 2 ? 'md:order-1' : ''}>
          <FlowFigure project={p} />
        </div>
      </article>
    ))}
  </div>

  <div class="mt-24">
    <SectionHeader index="03" label="more work" title="Also shipped" />
    <div class="grid gap-4 md:grid-cols-3">
      {moreWork.map((m) => (
        <article class="glass p-6 transition-transform duration-200 hover:-translate-y-1">
          <h3 class="display text-lg font-semibold">{m.title}</h3>
          <p class="mt-2 text-sm text-ink-muted">{m.body}</p>
          <p class="mt-4 font-mono text-xs text-accent-glow">{m.tech}</p>
        </article>
      ))}
    </div>
  </div>
</section>
