---
import { experience, education } from '../data/resume';
import SectionHeader from './SectionHeader.astro';
---

<section id="experience" class="scroll-mt-24 py-24">
  <div class="grid gap-16 md:grid-cols-5">
    <div class="md:col-span-3">
      <SectionHeader index="04" label="experience" title="Where I've worked" />
      <ol class="relative ml-3 border-l border-line pl-8" data-timeline>
        {experience.map((job) => (
          <li class="relative mb-10">
            <span
              class={`absolute -left-[2.45rem] top-1.5 h-3 w-3 rounded-full ${job.current ? 'bg-accent-glow shadow-glow' : 'bg-hover'}`}
              aria-hidden="true"
            ></span>
            <p class="font-mono text-xs text-ink-muted">{job.when} · {job.where}</p>
            <h3 class="display text-xl font-semibold">{job.company}</h3>
            <p class="text-sm text-ink-muted">{job.role}</p>
            {job.blurb && <p class="mt-1 text-sm italic text-ink-muted">{job.blurb}</p>}
            <ul class="mt-3 space-y-1.5 text-sm text-ink-muted">
              {job.highlights.map((h) => (
                <li class="flex gap-2"><span class="text-accent-glow" aria-hidden="true">›</span><span>{h}</span></li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>

    <div class="md:col-span-2">
      <SectionHeader index="05" label="education" title="Education" />
      <ul class="grid gap-4">
        {education.map((e) => (
          <li class="glass p-5">
            <h3 class="display text-lg font-semibold">{e.school}</h3>
            <p class="text-sm text-ink-muted">{e.detail}</p>
            <p class="mt-2 font-mono text-xs text-ink-muted">{e.where} · {e.when}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
